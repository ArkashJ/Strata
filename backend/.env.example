# Copy to .env and fill in. All keys optional for tests (HTTP is mocked).
# .env is loaded automatically at CLI + API startup via python-dotenv.

# Resolver (POST /resolve) — Claude over the Anthropic SDK + Exa web search.
# Without these, /resolve falls back to honest "couldn't resolve" messaging.
ANTHROPIC_API_KEY=
EXA_API_KEY=

# Connector keys. Most public APIs work without one (raises rate limits);
# the env var name must match what each connector reads.
BLS_API_KEY=
FRED_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=
OPENFDA_API_KEY=
KALSHI_API_KEY=
# USDA NASS — preferred name USDA_NASS_API_KEY (NASS_API_KEY also accepted).
USDA_NASS_API_KEY=
# SEC / EDGAR — sec-api.io 3rd-party key. EDGAR's free API only needs a
# user-agent (set EDGAR_USER_AGENT to your email); the SEC key is optional.
SEC_API_KEY=
EDGAR_USER_AGENT=

# Financial-market connectors.
ALPHA_VANTAGE_API_KEY=
NASDAQ_DATA_LINK_API_KEY=
DUNE_API_KEY=
# Census/EDGAR/World Bank/OECD/Eurostat/CMS/FDIC/FAA need no key.
