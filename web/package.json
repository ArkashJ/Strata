{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint",
    "lint": "bun run lint:biome && bun run lint:eslint",
    "format:biome": "biome format --write .",
    "format:prettier": "prettier --write \"**/*.{md,mdx,css,yaml,yml}\"",
    "format": "bun run format:biome && bun run format:prettier",
    "check": "bun run typecheck && bun run lint && bun run knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/lib/api-schema.d.ts",
    "gen:api:file": "openapi-typescript ../backend/openapi.json -o src/lib/api-schema.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.2",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "motion": "^12.40.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reactflow": "^11.11.4",
    "recharts": "3.8.0",
    "simple-icons": "^16.21.0",
    "tailwind-merge": "^3.6.0",
    "vis-data": "^8.0.4",
    "vis-network": "^10.1.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@clerk/testing": "^2.0.34",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^25.0.1",
    "knip": "^5.30.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.3",
    "storybook": "^10.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.2"
  }
}
