# Copy to `.env` for local dev (compose injects its own env; this is for `uv run`).
# Backend settings are read by pydantic-settings with the `STRATA_` prefix.
# Two keys are deliberately UNPREFIXED — the upstream SDKs read them directly:
#   ANTHROPIC_API_KEY  (anthropic SDK)   EXA_API_KEY  (exa-py SDK)

# ── Core runtime ────────────────────────────────────────────────────
STRATA_ENV=dev                  # dev | test | prod
STRATA_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
STRATA_LOG_JSON=false           # true → structured JSON logs (use in prod)

# Async DSN. Driver MUST be `asyncpg`.
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata

# JSON array of allowed CORS origins.
STRATA_CORS_ORIGINS=["http://localhost:3000","https://strata-pied-three.vercel.app"]

# Path to YAML data directory (relative to working dir or absolute).
STRATA_DATA_DIR=data

# ── SQLAlchemy async engine pool (prod tuning) ──────────────────────
# Consumed via Settings.engine_pool_kwargs(). Defaults suit one service
# container + managed Postgres. Raise pool_size/overflow with more workers.
STRATA_DB_POOL_SIZE=10          # persistent connections per process
STRATA_DB_MAX_OVERFLOW=5        # burst connections beyond pool_size
STRATA_DB_POOL_TIMEOUT=30       # seconds to wait for a free connection
STRATA_DB_POOL_RECYCLE=1800     # recycle connections older than N seconds
STRATA_DB_POOL_PRE_PING=true    # validate connections before checkout

# ── Container boot behaviour (entrypoint.sh) ────────────────────────
# entrypoint always runs `alembic upgrade head`. Set to 1 to ALSO run
# `strata db seed -d $STRATA_DATA_DIR` on boot (idempotent upsert).
STRATA_SEED_ON_BOOT=0

# ── /resolve dynamic-query keys (UNPREFIXED — read by the SDKs) ─────
# ANTHROPIC_API_KEY=sk-ant-...   # Claude — query parsing in POST /resolve
# EXA_API_KEY=...                # Exa — web search backing /resolve

# ── strata goal / CLI behaviour ─────────────────────────────────────
# Set to 1 to disable `strata goal` step 3 (connector live) + step 4
# (Claude+Exa fallback). Useful for CI / sandboxed environments.
STRATA_OFFLINE=0

# ── Connector API keys (all optional — connectors degrade without them) ──
# BLS: register at https://data.bls.gov/registrationEngine/
# STRATA_BLS_API_KEY=
# FRED: register at https://fred.stlouisfed.org/docs/api/api_key.html
# STRATA_FRED_API_KEY=
# Census: optional, register at https://api.census.gov/data/key_signup.html
# STRATA_CENSUS_API_KEY=
# Kalshi: create at https://kalshi.com → Account & Security → API Keys
# STRATA_KALSHI_API_KEY=
# Path to RSA private key .pem file (downloaded when creating the Kalshi key)
# STRATA_KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem
# EIA: register at https://www.eia.gov/opendata/register.php (free, instant)
# STRATA_EIA_API_KEY=
# USDA NASS: register at https://quickstats.nass.usda.gov/api (free, instant)
# STRATA_USDA_NASS_API_KEY=
# openFDA: register at https://open.fda.gov/apis/authentication/ (higher limits)
# STRATA_OPENFDA_API_KEY=
# UN Comtrade: register at https://comtradeplus.un.org/ (free account)
# STRATA_COMTRADE_API_KEY=

# ── v0.3 connector API keys ─────────────────────────────────────────
# Alpha Vantage: register at https://www.alphavantage.co/support/#api-key
# STRATA_ALPHA_VANTAGE_API_KEY=
# Nasdaq Data Link: register at https://data.nasdaq.com/ (key optional)
# STRATA_NASDAQ_DATA_LINK_API_KEY=
# Reddit: create an app at https://www.reddit.com/prefs/apps (script type)
# STRATA_REDDIT_CLIENT_ID=
# STRATA_REDDIT_CLIENT_SECRET=
# GitHub: classic PAT at https://github.com/settings/tokens (public-repo reads)
# STRATA_GITHUB_TOKEN=
# Stack Exchange: key optional at https://stackapps.com/apps/oauth/register
# STRATA_STACK_EXCHANGE_KEY=
# Twitter / X: bearer token from https://developer.x.com/ (free tier)
# STRATA_TWITTER_BEARER_TOKEN=
# yfinance: no key — fragile unofficial scraper, router demotes by default

# ── Frontend (web/.env.local) ───────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Railway deployment ──────────────────────────────────────────────
# Railway injects PORT; entrypoint.sh honours it (falls back to 8000).
# Set these in the Railway service's Variables tab:
#   STRATA_ENV=prod
#   STRATA_LOG_JSON=true
#   STRATA_DATABASE_URL=${{Postgres.DATABASE_URL}}   # if using Railway Postgres
#   STRATA_CORS_ORIGINS=["https://strata-pied-three.vercel.app"]
#   STRATA_SEED_ON_BOOT=1                            # first deploy only, then 0
#   ANTHROPIC_API_KEY=<your key>                     # for /resolve
#   EXA_API_KEY=<your key>                           # for /resolve
#   STRATA_BLS_API_KEY / STRATA_FRED_API_KEY / ... as needed
#
# With STRATA_SEED_ON_BOOT=1 the entrypoint migrates + seeds automatically.
# Otherwise run once in the Railway shell:
#   alembic upgrade head
#   strata db seed -d /app/data
