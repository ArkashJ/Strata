# Strata environment variables — copy to .env and fill in.
# Backend reads these at runtime; never commit the filled-in .env.

# --- LLM + search (required for /resolve and `strata goal`) ---
ANTHROPIC_API_KEY=
EXA_API_KEY=

# --- Connector API keys (optional; connectors degrade without them) ---
BLS_API_KEY=
FRED_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=
NASDAQ_DATA_LINK_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Database (Postgres; required in production) ---
DATABASE_URL=postgresql://strata:strata@localhost:5432/strata
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# --- Server ---
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Auth (Clerk; frontend Track C). Leave blank to run without auth — the app
#     degrades gracefully and /dashboard shows a "not configured" notice. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
