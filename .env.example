# Copy to `.env` for local dev (compose injects its own env; this is for `uv run`).
# All backend settings are prefixed `STRATA_`.

STRATA_ENV=dev
STRATA_LOG_LEVEL=INFO
STRATA_LOG_JSON=false

# Async DSN. Driver must be `asyncpg`.
STRATA_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata

# JSON array of allowed origins.
STRATA_CORS_ORIGINS=["http://localhost:3000","https://strata-pied-three.vercel.app"]

# Path to YAML data directory (relative to working dir or absolute).
STRATA_DATA_DIR=data

# --- Connector API keys ---
# BLS: register at https://data.bls.gov/registrationEngine/
# STRATA_BLS_API_KEY=
# FRED: register at https://fred.stlouisfed.org/docs/api/api_key.html
# STRATA_FRED_API_KEY=
# Census: optional, register at https://api.census.gov/data/key_signup.html
# STRATA_CENSUS_API_KEY=
# Kalshi: create at https://kalshi.com → Account & Security → API Keys
# STRATA_KALSHI_API_KEY=
# Path to RSA private key .pem file (downloaded when creating API key)
# STRATA_KALSHI_PRIVATE_KEY_PATH=~/.kalshi/private_key.pem

# EIA: register at https://www.eia.gov/opendata/register.php (free, instant)
# STRATA_EIA_API_KEY=
# USDA NASS: register at https://quickstats.nass.usda.gov/api (free, instant)
# STRATA_USDA_NASS_API_KEY=
# openFDA: register at https://open.fda.gov/apis/authentication/ (optional, higher limits)
# STRATA_OPENFDA_API_KEY=
# UN Comtrade: register at https://comtradeplus.un.org/ (free account for API access)
# STRATA_COMTRADE_API_KEY=

# --- v0.3 connector API keys (PR-A) ---
# Alpha Vantage: register at https://www.alphavantage.co/support/#api-key (free 25 req/day)
# STRATA_ALPHA_VANTAGE_API_KEY=
# Nasdaq Data Link: register at https://data.nasdaq.com/ (key optional for free datasets)
# STRATA_NASDAQ_DATA_LINK_API_KEY=
# Reddit: create an app at https://www.reddit.com/prefs/apps (script type)
# STRATA_REDDIT_CLIENT_ID=
# STRATA_REDDIT_CLIENT_SECRET=
# GitHub: classic PAT at https://github.com/settings/tokens (no scopes needed for public-repo reads)
# STRATA_GITHUB_TOKEN=
# Stack Exchange: key optional at https://stackapps.com/apps/oauth/register
# STRATA_STACK_EXCHANGE_KEY=
# Twitter / X: bearer token from https://developer.x.com/ (free tier — user lookup + timeline only)
# STRATA_TWITTER_BEARER_TOKEN=
# yfinance: no key — fragile unofficial scraper, router demotes by default

# --- v0.3 CLI behaviour ---
# Set STRATA_OFFLINE=1 to disable `strata goal` step 3 (connector live) + step 4
# (Claude+Exa fallback). Useful for CI / sandboxed environments.
# STRATA_OFFLINE=

# --- frontend (web/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Railway deployment ---
# Railway sets PORT automatically. The Dockerfile uses 8000; Railway will
# route traffic to it via its proxy. Set these in Railway's service variables:
#   STRATA_ENV=prod
#   STRATA_LOG_JSON=true
#   STRATA_DATABASE_URL=${{Postgres.DATABASE_URL}}  (if using Railway Postgres)
#   STRATA_CORS_ORIGINS=["https://strata-pied-three.vercel.app"]
#   STRATA_BLS_API_KEY=<your key>
#   STRATA_FRED_API_KEY=<your key>
#   STRATA_CENSUS_API_KEY=<your key>
#   STRATA_KALSHI_API_KEY=<your key>
#   STRATA_KALSHI_PRIVATE_KEY_PATH=/app/.kalshi/private_key.pem
#   STRATA_EIA_API_KEY=<your key>
#   STRATA_USDA_NASS_API_KEY=<your key>
#   STRATA_OPENFDA_API_KEY=<your key>
#   STRATA_COMTRADE_API_KEY=<your key>
#
# After first deploy, run in Railway shell:
#   alembic upgrade head
#   python -m strata.cli db seed -d /app/data
#
# YAML files are baked into Docker image. Postgres is the production
# source of truth after seeding. No need to re-seed unless adding data.
